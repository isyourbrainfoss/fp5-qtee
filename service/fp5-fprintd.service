[Unit]
Description=FP5 fingerprint daemon (net.reactivated.Fprint over fp5-qtee-session)
Documentation=file:///usr/share/doc/fp5-qtee/fprintd.md
ConditionPathExists=/dev/tee0
After=mnt-persist.mount
Wants=mnt-persist.mount

[Service]
Type=dbus
BusName=net.reactivated.Fprint
ExecStart=/usr/bin/python3 /usr/libexec/fp5-qtee/fp5-fprintd
Environment=FP5_FPRINTD_SESSION=/usr/libexec/fp5-qtee/fp5-qtee-session
Environment=FP5_FPRINTD_FW=/var/lib/firmware/qsee
Environment=FP5_FPRINTD_STATE=/var/lib/fp5-fprintd
Environment=FP5_FPRINTD_SEED=0
# Sync fingers.json from the trustlet's list once at start (only if the
# sensor is free). Set to 0 in a drop-in to skip.
Environment=FP5_FPRINTD_LIST_AT_START=1
Environment=FP5_QTEE_FW_DIR=/var/lib/firmware/qsee
Environment=FP5_QTEE_MOUNT_PERSIST=0
StateDirectory=fp5-fprintd
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
# Root for /dev/tee0, the RPMB SG_IO path and the GP files on /mnt/persist.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/mnt/persist
# Compact memory (and drop caches if that is not enough) when no 4 MiB
# contiguous block is free for the qcomtee session buffer.
ReadWritePaths=/proc/sys/vm/compact_memory
ReadWritePaths=/proc/sys/vm/drop_caches
# ProtectSystem=strict leaves /tmp read-only (no PrivateTmp here: the lock
# is shared with app/fp5-qtee and the scripts), so /tmp/fp5-qtee-phone.lock
# could not be created and every VerifyStart failed.
ReadWritePaths=/tmp
# /run/fp5-fprintd/want-sensor: tells the unlock watcher to quit its kept
# session while unlocked. 0755 so the user watcher can see it.
RuntimeDirectory=fp5-fprintd
RuntimeDirectoryMode=0755
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
