[Unit]
Description=FP5 fingerprint (QTEE) session for one client
Documentation=file:///usr/share/doc/fp5-qtee/bengalos-mbn.md
After=mnt-persist.mount
Wants=mnt-persist.mount
# The unit name must be <socket name>@.service: fp5-qtee.socket has Accept=yes.

[Service]
Type=simple
ExecStart=/usr/libexec/fp5-qtee/fp5-qtee-broker
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=FP5_QTEE_FW_DIR=/var/lib/firmware/qsee
# BengalOS mounts persist itself (mnt-persist.mount, read-only for now).
Environment=FP5_QTEE_MOUNT_PERSIST=0
# Root is needed for /dev/tee0, the RPMB SG_IO path and the GP files on
# /mnt/persist. Keep the rest small.
User=root
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/mnt/persist
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Hard cap; enroll is the longest mode (about 25 min with coaching).
RuntimeMaxSec=1800
