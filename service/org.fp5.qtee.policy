<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>fp5-qtee</vendor>

  <action id="org.fp5.qtee.unlock">
    <description>Check a fingerprint to unlock the phone</description>
    <message>A fingerprint check needs your permission</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.fp5.qtee.list">
    <description>List the saved fingerprints</description>
    <message>Listing fingerprints needs your permission</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.fp5.qtee.manage">
    <description>Add or remove a fingerprint</description>
    <message>Adding or removing a fingerprint needs your password</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
