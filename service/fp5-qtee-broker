#!/usr/bin/python3
"""fp5-qtee-broker: the system side of the fp5-qtee socket (no sudo).

Started by fp5-qtee@.service, one instance per connection, with
the accepted socket as stdin/stdout. It:

1. reads exactly one line "MODE <mode> [args...]" (byte by byte, so no
   later protocol bytes are swallowed);
2. finds the caller with SO_PEERCRED;
3. asks polkit (pkcheck) whether that process may run the mode;
4. execs the session binary with the socket still on stdin/stdout.

Modes and polkit actions:
  serve, unlock, auth    org.fp5.qtee.unlock   (active session: yes)
  list                   org.fp5.qtee.list     (active session: yes)
  enroll, remove         org.fp5.qtee.manage   (auth_admin_keep)
Anything else (probe, bench, ...) is refused: those are developer modes
and stay a root-shell thing.
"""

import os
import re
import socket
import struct
import subprocess
from pathlib import Path
from typing import Callable
import sys
import time

SESSION = os.environ.get("FP5_QTEE_SESSION", "/usr/libexec/fp5-qtee/fp5-qtee-session")
FW_DIR = os.environ.get("FP5_QTEE_FW_DIR", "/var/lib/firmware/qsee")
ACTIONS = {
    "serve": "org.fp5.qtee.unlock",
    "unlock": "org.fp5.qtee.unlock",
    "auth": "org.fp5.qtee.unlock",  # the app's Match button
    "list": "org.fp5.qtee.list",
    "enroll": "org.fp5.qtee.manage",
    "remove": "org.fp5.qtee.manage",
}
ARG_RE = re.compile(r"^[0-9A-Za-z_.-]{1,32}$")
MAX_ARGS = {"remove": 4}
MAX_LINE = 256


# qcomtee allocates one 4 MiB physically contiguous buffer (order 10) per
# session. With fragmented RAM that fails ("page allocation failure:
# order:10") and the session exits at once, so fingerprint unlock stops.
COMPACT = Path("/proc/sys/vm/compact_memory")
DROP_CACHES = Path("/proc/sys/vm/drop_caches")
# Short waits between the last compactions (kcompactd and reclaim catch up).
BACKOFF_S = (0.3, 0.7)
BUDDYINFO = Path("/proc/buddyinfo")


def free_order10(text: str | None = None) -> int:
    """Free order-10 blocks over all zones (the last /proc/buddyinfo column)."""
    if text is None:
        try:
            text = BUDDYINFO.read_text()
        except OSError:
            return -1
    total = 0
    for line in text.splitlines():
        parts = line.split()
        if "zone" not in parts:
            continue
        counts = parts[parts.index("zone") + 2:]
        if len(counts) >= 11 and counts[10].isdigit():
            total += int(counts[10])
    return total


def compact_if_needed(free: "Callable[[], int] | None" = None,
                      write: "Callable[[Path, str], None] | None" = None,
                      sleep: "Callable[[float], None] | None" = None) -> int:
    """Make one order-10 block free before a session. Returns free blocks after.

    Steps, each only while none is free: compact; drop the page cache and
    compact; drop caches and slab (3) and compact; then wait a little and
    look again (BACKOFF_S). With Waydroid running (about 1-1.5 GB, 1 GB in
    swap) compaction alone found nothing ("compacted, now 0") while drop
    caches + compact gave 55 blocks. -1 when /proc/buddyinfo is unreadable
    (then nothing is done).
    """
    free = free if free is not None else free_order10
    sleep = sleep if sleep is not None else time.sleep

    def put(path: Path, text: str) -> None:
        if write is not None:
            write(path, text)
            return
        try:
            path.write_text(text)
        except OSError as exc:
            print(f"fp5-qtee: {path.name}: {exc}", file=sys.stderr, flush=True)

    have = free()
    if have != 0:
        return have
    steps = [None, "1", "3"]
    for n, drop in enumerate(steps):
        if drop is not None:
            put(DROP_CACHES, drop + "\n")
        put(COMPACT, "1\n")
        have = free()
        print(f"fp5-qtee: no free order-10 block; step {n + 1}"
              f" (drop_caches={drop or '-'}) now {have}", file=sys.stderr, flush=True)
        if have != 0:
            return have
    for wait in BACKOFF_S:
        sleep(wait)
        put(COMPACT, "1\n")
        have = free()
        if have != 0:
            break
    print(f"fp5-qtee: after backoff {have} order-10 blocks", file=sys.stderr, flush=True)
    return have


def say(msg: str) -> None:
    try:
        os.write(1, (msg + "\n").encode())
    except OSError:
        pass
    print(msg, file=sys.stderr, flush=True)


def read_line(fd: int) -> str:
    buf = bytearray()
    while len(buf) < MAX_LINE:
        b = os.read(fd, 1)
        if not b:
            break
        if b == b"\n":
            return buf.decode("ascii", "strict")
        buf += b
    raise ValueError("no MODE line")


def peer(sock: socket.socket) -> tuple[int, int, int]:
    data = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", data)


def start_time(pid: int) -> str:
    with open(f"/proc/{pid}/stat") as f:
        stat = f.read()
    # Field 22, counted after the ")" that ends the comm field.
    return stat.rsplit(")", 1)[1].split()[19]


def allowed(action: str, pid: int, uid: int) -> bool:
    if uid == 0:
        return True
    subject = f"{pid},{start_time(pid)},{uid}"
    res = subprocess.run(
        ["pkcheck", "--action-id", action, "--process", subject,
         "--allow-user-interaction"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, timeout=120,
    )
    return res.returncode == 0


def main() -> int:
    sock = socket.socket(fileno=os.dup(0))
    try:
        pid, uid, _gid = peer(sock)
        words = read_line(0).split()
    except (OSError, ValueError, UnicodeDecodeError) as exc:
        say(f"BROKER refused: {exc}")
        return 2
    if len(words) < 2 or words[0] != "MODE" or words[1] not in ACTIONS:
        say("BROKER refused: unknown mode")
        return 2
    mode, args = words[1], words[2:]
    if len(args) > MAX_ARGS.get(mode, 0) or not all(ARG_RE.match(a) for a in args):
        say("BROKER refused: bad arguments")
        return 2
    try:
        ok = allowed(ACTIONS[mode], pid, uid)
    except (OSError, subprocess.SubprocessError) as exc:
        say(f"BROKER refused: polkit check failed: {exc}")
        return 3
    if not ok:
        say(f"BROKER refused: not authorized for {ACTIONS[mode]}")
        return 3
    print(f"fp5-qtee: uid {uid} pid {pid} mode {mode}", file=sys.stderr, flush=True)
    sock.close()
    compact_if_needed()
    os.execv(SESSION, [SESSION, mode, FW_DIR, *args])
    return 127


if __name__ == "__main__":
    sys.exit(main())
